<div class="list grid quarto-listing-cols-3">
<% items.forEach(function(item, index) { %>
<div class="g-col-1" data-index="<%= index %>" data-categories="<%= utils.b64encode(item.categories.join(",")) %>"<% if (item.datesort) { %> data-listing-date-sort="<%= item.datesort %>"<% } %>>
<a href="<%- item.link %>" class="quarto-grid-link" target="_blank" rel="noopener noreferrer">
<div class="quarto-grid-item card h-100 card-left">
<div class="card-body post-contents">
<h5 class="no-anchor card-title listing-title"><%= item.title %></h5>
<% if (item.categories && item.categories.length > 0) { %>
<div class="listing-categories">
<% for (const category of item.categories) { %>
<div class="listing-category" onclick="window.quartoListingCategory('<%= utils.b64encode(category) %>'); return false;"><%= category %></div>
<% } %>
</div>
<% } %>
<% if (item.description) { %>
<div class="card-text listing-description delink"><p><%= item.description %></p></div>
<% } %>
<% if (item.date) { %>
<div class="card-attribution card-text-small end">
<div class="listing-date"><%= item.date %></div>
</div>
<% } %>
</div>
</div>
</a>
</div>
<% }); %>
</div>
